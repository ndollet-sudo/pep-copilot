# Copy to .env (never commit .env - it is git-ignored). Loaded automatically by config.py.
OPENAI_API_KEY=sk-...

# Optional overrides
# PEPCOPILOT_PROVIDER=openai            # or openrouter (then set OPENROUTER_API_KEY)
# PEPCOPILOT_CHAT_MODEL=gpt-4o-mini
# PEPCOPILOT_EMBED_MODEL=text-embedding-3-small
# PEPCOPILOT_CHUNKING=fixed_header
# Prices in USD per 1M tokens, if OpenAI changes them:
# PEPCOPILOT_PRICE_CHAT_IN=0.15
# PEPCOPILOT_PRICE_CHAT_OUT=0.60
# PEPCOPILOT_PRICE_EMBED_IN=0.02
